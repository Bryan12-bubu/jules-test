# ================================================================
# ==                Example Configuration File                  ==
# ================================================================
#
# Copy this file to a new file named .env and fill in the values.
# The application loads its configuration from the .env file.
#
# ----------------------------------------------------------------
# --                      IMPORTANT                           --
# --  This .env file should NOT be committed to version control --
# ----------------------------------------------------------------


# --- Google Cloud Platform Settings ---
# Your Google Cloud Project ID. The Vertex AI API must be enabled in this project.
GCP_PROJECT_ID="your-gcp-project-id-here"

# The GCP region to run Vertex AI jobs in.
GCP_LOCATION="us-central1"


# --- Model Selection for Cost Control ---
# Specify the exact Vertex AI model versions to use for generation.
# By changing these values, you can control which models are used and manage costs.
# You can find available model names in the Google Cloud documentation.
#
# Example for Image Generation:
IMAGE_GENERATION_MODEL="imagegeneration@006"
#
# Example for Video Generation (NOTE: This is a placeholder name. You will need
# to find a real, available text-to-video model name from Vertex AI documentation).
VIDEO_GENERATION_MODEL="imagica@001"
